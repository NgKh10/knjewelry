@model List<knjewelry.Models.ViewModels.GioHangSessionItem>
@{
    ViewData["Title"] = "Giỏ hàng - K&N JEWELRY";
}

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0">
                <a href="/">Trang chủ</a> <span class="mx-2 mb-0">/</span>
                <strong class="text-black">Giỏ hàng</strong>
            </div>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            @TempData["CartError"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <!-- Form gửi sản phẩm đã chọn đến thanh toán -->
        <form id="form-checkout" asp-controller="GioHang" asp-action="XacNhanGioHang" method="post">
            <input type="hidden" id="selected-keys" name="selectedKeys" />
        </form>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="thead-light">
                    <tr>
                        <th style="width:44px;" class="text-center">
                            <input type="checkbox" id="check-all" checked title="Chọn tất cả">
                        </th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var key = $"{item.SanPhamId}-{(item.BienTheId?.ToString() ?? "0")}";
                        <tr class="cart-row">
                            <td class="text-center">
                                <input type="checkbox" class="item-check"
                                       data-key="@key"
                                       data-price="@item.DonGia"
                                       data-qty="@item.SoLuong"
                                       checked>
                            </td>
                            <td>
                                <img src="@item.HinhAnh" alt="@item.TenSanPham"
                                     style="width:60px;height:60px;object-fit:cover;border-radius:4px;">
                            </td>
                            <td>
                                <strong>@item.TenSanPham</strong>
                                @if (!string.IsNullOrEmpty(item.KichCo) || !string.IsNullOrEmpty(item.MauSac))
                                {
                                    <br>
                                    <small class="text-muted">
                                        @string.Join(" / ", new[] { item.KichCo, item.MauSac }.Where(x => !string.IsNullOrEmpty(x)))
                                    </small>
                                }
                            </td>
                            <td class="text-nowrap">@string.Format("{0:N0}₫", item.DonGia)</td>
                            <td>
                                <div class="input-group" style="width:120px;">
                                    <button class="btn btn-outline-secondary btn-minus"
                                            data-id="@item.SanPhamId"
                                            data-bien-the-id="@(item.BienTheId?.ToString() ?? "")">-</button>
                                    <input type="text" class="form-control text-center qty-input"
                                           value="@item.SoLuong"
                                           data-id="@item.SanPhamId"
                                           data-price="@item.DonGia"
                                           data-bien-the-id="@(item.BienTheId?.ToString() ?? "")"
                                           style="width:40px;">
                                    <button class="btn btn-outline-secondary btn-plus"
                                            data-id="@item.SanPhamId"
                                            data-bien-the-id="@(item.BienTheId?.ToString() ?? "")">+</button>
                                </div>
                            </td>
                            <td class="text-nowrap row-total" data-key="@key">
                                @string.Format("{0:N0}₫", item.ThanhTien)
                            </td>
                            <td>
                                <form method="post" asp-controller="GioHang" asp-action="XoaKhoiGio" style="display:inline;">
                                    <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />
                                    <input type="hidden" name="bienTheId" value="@(item.BienTheId?.ToString() ?? "")" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Tổng kết + Thanh toán -->
        <div class="row mt-4">
            <div class="col-md-6">
                <small class="text-muted">
                    <i class='bx bx-info-circle'></i>
                    Miễn phí vận chuyển cho đơn hàng từ 150.000₫
                </small>
            </div>
            <div class="col-md-6 text-right">
                <div class="border p-3 d-inline-block" style="min-width:280px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Đã chọn:</span>
                        <strong><span id="selected-count">0</span> sản phẩm</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tạm tính:</span>
                        <strong class="text-danger" id="selected-total" style="font-size:1.2rem;">0₫</strong>
                    </div>
                    <button id="btn-checkout" class="btn btn-black btn-block" disabled>
                        Tiến hành thanh toán
                        <i class='bx bx-right-arrow-alt'></i>
                    </button>
                    <a href="/SanPham" class="btn btn-outline-secondary btn-block mt-2">
                        <i class='bx bx-store'></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class='bx bx-cart bx-lg' style="font-size:60px;color:#ccc;"></i>
            <h3 class="mt-3">Giỏ hàng của bạn đang trống</h3>
            <p><a href="/SanPham" class="btn btn-black mt-3">Mua sắm ngay</a></p>
        </div>
    }
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {

    // ── Cập nhật tổng tiền sản phẩm được chọn ─────────────────
    function updateSubtotal() {
        var total = 0;
        var count = 0;
        var keys  = [];

        $('.item-check:checked').each(function () {
            var $row  = $(this).closest('tr');
            var price = parseFloat($(this).data('price'));
            var qty   = parseInt($row.find('.qty-input').val()) || 1;
            total += price * qty;
            count++;
            keys.push($(this).data('key'));
        });

        $('#selected-count').text(count);
        $('#selected-total').text(total.toLocaleString('vi-VN') + '₫');
        $('#btn-checkout').prop('disabled', count === 0);
        $('#selected-keys').val(keys.join(','));
    }

    // ── Chọn tất cả / bỏ chọn tất cả ─────────────────────────
    $('#check-all').change(function () {
        $('.item-check').prop('checked', $(this).is(':checked'));
        updateSubtotal();
    });

    // ── Checkbox từng dòng ────────────────────────────────────
    $('.item-check').change(function () {
        var allChecked = $('.item-check:checked').length === $('.item-check').length;
        $('#check-all').prop('checked', allChecked);
        updateSubtotal();
    });

    // ── Nút thanh toán → submit form ──────────────────────────
    $('#btn-checkout').click(function () {
        if ($('#selected-keys').val()) {
            $('#form-checkout').submit();
        }
    });

    // ── Tăng số lượng ─────────────────────────────────────────
    $('.btn-plus').click(function () {
        var id        = $(this).data('id');
        var bienTheId = $(this).data('bien-the-id') || '';
        var input     = $(this).closest('tr').find('.qty-input');
        var qty       = parseInt(input.val()) + 1;
        updateQty(id, bienTheId, qty, input);
    });

    // ── Giảm số lượng ─────────────────────────────────────────
    $('.btn-minus').click(function () {
        var id        = $(this).data('id');
        var bienTheId = $(this).data('bien-the-id') || '';
        var input     = $(this).closest('tr').find('.qty-input');
        var qty       = parseInt(input.val()) - 1;
        if (qty < 1) qty = 1;
        updateQty(id, bienTheId, qty, input);
    });

    function updateQty(id, bienTheId, qty, input) {
        input.val(qty);
        // Cập nhật data-qty cho checkbox của dòng này
        input.closest('tr').find('.item-check').data('qty', qty);
        $.post('/GioHang/CapNhatSoLuong',
            { sanPhamId: id, bienTheId: bienTheId, soLuong: qty },
            function (res) {
                if (res.success) location.reload();
            }
        );
    }

    // ── Khởi tạo ──────────────────────────────────────────────
    updateSubtotal();

});
</script>
}
