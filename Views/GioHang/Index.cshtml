@model List<knjewelry.Models.ViewModels.GioHangSessionItem>
@{
    ViewData["Title"] = "Giỏ hàng - K&N JEWELRY";
}

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0">
                <a href="/">Trang chủ</a> <span class="mx-2 mb-0">/</span>
                <strong class="text-black">Giỏ hàng</strong>
            </div>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><img src="@item.HinhAnh" alt="@item.TenSanPham" style="width: 60px; height: 60px; object-fit: cover;"></td>
                                <td>@item.TenSanPham</td>
                                <td>@string.Format("{0:N0}₫", item.DonGia)</td>
                                <td>
                                    <div class="input-group" style="width: 100px;">
                                        <button class="btn btn-outline-secondary btn-minus" data-id="@item.SanPhamId">-</button>
                                        <input type="text" class="form-control text-center qty-input" value="@item.SoLuong" data-id="@item.SanPhamId" style="width: 40px;">
                                        <button class="btn btn-outline-secondary btn-plus" data-id="@item.SanPhamId">+</button>
                                    </div>
                                </td>
                                <td>@string.Format("{0:N0}₫", item.ThanhTien)</td>
                                <td><a href="/GioHang/XoaKhoiGio?sanPhamId=@item.SanPhamId" class="btn btn-danger btn-sm">Xóa</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-right mt-4">
                <h4>Tổng tiền: <strong class="text-danger">@string.Format("{0:N0}₫", Model.Sum(x => x.ThanhTien))</strong></h4>
                <a href="/ThanhToan" class="btn btn-black mt-3">Tiến hành thanh toán</a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class='bx bx-cart bx-lg' style="font-size: 60px; color: #ccc;"></i>
                <h3 class="mt-3">Giỏ hàng của bạn đang trống</h3>
                <p><a href="/SanPham" class="btn btn-black mt-3">Mua sắm ngay</a></p>
            </div>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
        // Cập nhật số lượng
        function updateCart(id, size, mau, qty) {
            $.post('/GioHang/CapNhatSoLuong', { 
                sanPhamId: id, 
                size: size, 
                mauSac: mau, 
                soLuong: qty 
            }, function (response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Cập nhật thất bại');
                }
            });
        }
        
        // Nút tăng
        $('.btn-plus').click(function () {
            var id = $(this).data('id');
            var size = $(this).data('size') || '';
            var mau = $(this).data('mau') || '';
            var input = $(this).closest('tr').find('.qty-input');
            var qty = parseInt(input.val()) + 1;
            updateCart(id, size, mau, qty);
        });

        // Nút giảm
        $('.btn-minus').click(function () {
            var id = $(this).data('id');
            var size = $(this).data('size') || '';
            var mau = $(this).data('mau') || '';
            var input = $(this).closest('tr').find('.qty-input');
            var qty = parseInt(input.val()) - 1;
            if (qty < 1) qty = 1;
            updateCart(id, size, mau, qty);
        });
        
        // Xóa sản phẩm
        $('.btn-remove').click(function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            var size = $(this).data('size') || '';
            var mau = $(this).data('mau') || '';
            if (confirm('Bạn có chắc muốn xóa sản phẩm này?')) {
                $.post('/GioHang/XoaKhoiGio', { 
                    sanPhamId: id, 
                    size: size, 
                    mauSac: mau 
                }, function () {
                    location.reload();
                });
            }
        });
    });
</script>