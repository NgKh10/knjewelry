@model knjewelry.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "K&N JEWELRY - Trang sức bạc cao cấp";
}

<!-- Hero Banner -->
<!-- Hero Banner -->
<div class="site-blocks-cover" data-aos="fade">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 order-md-2">
                <div class="site-block-cover-content text-center text-md-start">
                    <h2 class="sub-title">#NEW SUMMER COLLECTION 2026</h2>
                    <h1 class="hero-title">BỘ SƯU TẬP<br>MỚI</h1>
                    <p><a href="/SanPham" class="btn btn-black rounded-0">MUA NGAY</a></p>
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <img src="~/images/model_3.png" alt="Model" class="img-fluid hero-image">
            </div>
        </div>
    </div>
</div>

<!-- Features -->
<div class="site-section">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="feature-item text-center">
                    <i class='bx bx-truck bx-lg'></i>
                    <h4>Miễn phí vận chuyển</h4>
                    <p>Cho đơn hàng từ 150.000đ</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-item text-center">
                    <i class='bx bx-shield-alt bx-lg'></i>
                    <h4>Bảo hành trọn đời</h4>
                    <p>Đánh bóng miễn phí</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-item text-center">
                    <i class='bx bx-undo bx-lg'></i>
                    <h4>Đổi trả dễ dàng</h4>
                    <p>Trong vòng 30 ngày</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-item text-center">
                    <i class='bx bx-diamond bx-lg'></i>
                    <h4>Chất lượng cao</h4>
                    <p>100% bạc nguyên chất</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm mới -->
<div class="site-section">
    <div class="container">
        <div class="title-section text-center mb-5">
            <h2>Sản phẩm mới</h2>
            <p>Những mẫu thiết kế mới nhất</p>
        </div>
        <div class="row">
            @if (Model.SanPhamMoi != null && Model.SanPhamMoi.Any())
            {
                @foreach (var product in Model.SanPhamMoi.Take(8))
                {
                    <div class="col-lg-3 col-md-6 item-entry mb-4">
                        <a href="/SanPham/Detail/@product.id_san_pham" class="product-item d-block">
                            <img src="@(product.HinhAnhs?.FirstOrDefault()?.duong_dan ?? "/images/default.jpg")" alt="@product.ten_sp" class="img-fluid">
                            @if (product.gia_khuyen_mai.HasValue)
                            {
                                <span class="sale-badge">-@((int)((product.gia - product.gia_khuyen_mai.Value) / product.gia * 100))%</span>
                            }
                        </a>
                        <h3 class="item-title"><a href="/SanPham/Detail/@product.id_san_pham">@product.ten_sp</a></h3>
                        <div class="item-price">
                            @if (product.gia_khuyen_mai.HasValue)
                            {
                                <del>@string.Format("{0:N0}₫", product.gia)</del>
                                <span class="current-price">@string.Format("{0:N0}₫", product.gia_khuyen_mai)</span>
                            }
                            else
                            {
                                <span class="current-price">@string.Format("{0:N0}₫", product.gia)</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <div class="text-center mt-4">
            <a href="/SanPham" class="btn btn-black rounded-0">Xem tất cả</a>
        </div>
    </div>
</div>

<!-- Banner giữa trang -->
<div class="site-blocks-cover inner-page py-5" data-aos="fade">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="site-block-cover-content">
                    <h2 class="sub-title">#FLASH SALE</h2>
                    <h1>GIẢM GIÁ<br>LÊN ĐẾN 20%</h1>
                    <p><a href="/SanPham" class="btn btn-black rounded-0">MUA NGAY</a></p>
                </div>
            </div>
            <div class="col-md-6">
                <img src="~/images/sale.png" alt="Sale" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm bán chạy -->
<div class="site-section bg-light">
    <div class="container">
        <div class="title-section text-center mb-5">
            <h2>Sản phẩm bán chạy</h2>
            <p>Được yêu thích nhất</p>
        </div>
        <div class="row">
            @if (Model.SanPhamHot != null && Model.SanPhamHot.Any())
            {
                @foreach (var product in Model.SanPhamHot.Take(8))
                {
                    <div class="col-lg-3 col-md-6 item-entry mb-4">
                        <a href="/SanPham/Detail/@product.id_san_pham" class="product-item d-block">
                            <img src="@(product.HinhAnhs?.FirstOrDefault()?.duong_dan ?? "/images/default.jpg")" alt="@product.ten_sp" class="img-fluid">
                            <span class="sale-badge">Hot</span>
                        </a>
                        <h3 class="item-title"><a href="/SanPham/Detail/@product.id_san_pham">@product.ten_sp</a></h3>
                        <div class="item-price">
                            <span class="current-price">@string.Format("{0:N0}₫", product.gia_khuyen_mai ?? product.gia)</span>
                        </div>
                        <div class="star-rating">
                            <i class='bx bxs-star text-warning'></i>
                            <i class='bx bxs-star text-warning'></i>
                            <i class='bx bxs-star text-warning'></i>
                            <i class='bx bxs-star text-warning'></i>
                            <i class='bx bxs-star-half text-warning'></i>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Đăng ký nhận tin -->
<div class="site-section">
    <div class="container">
        <div class="newsletter-content text-center">
            <h3>Đăng ký nhận tin</h3>
            <p>Nhận thông tin ưu đãi và sản phẩm mới nhất</p>
            <form class="newsletter-form d-flex justify-content-center mt-4">
                <input type="email" class="form-control w-50" placeholder="Email của bạn">
                <button class="btn btn-black ms-2">Đăng ký</button>
            </form>
        </div>
    </div>
</div>