@model knjewelry.Models.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập - K&N JEWELRY";
}

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0">
                <a href="/">Trang chủ</a> <span class="mx-2 mb-0">/</span>
                <strong class="text-black">Đăng nhập</strong>
            </div>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="border p-5">
                    <h3 class="mb-4 text-center">Đăng nhập</h3>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form method="post">
                        <div class="form-group mb-3">
                            <label asp-for="TenDangNhap">Tên đăng nhập</label>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập">
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="MatKhau">Mật khẩu</label>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Mật khẩu">
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 form-check">
                            <input asp-for="GhiNho" class="form-check-input">
                            <label asp-for="GhiNho" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-black w-100 py-2">Đăng nhập</button>
                        </div>

                        <div class="text-center mt-3">
                            <p>Chưa có tài khoản? <a href="/TaiKhoan/DangKy">Đăng ký ngay</a></p>
                            <p><a href="#">Quên mật khẩu?</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>