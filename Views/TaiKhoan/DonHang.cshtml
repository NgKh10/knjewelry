@model IEnumerable<knjewelry.Models.Entities.HoaDon>
@{
    ViewData["Title"] = "Đơn hàng của tôi - K&N JEWELRY";
    var statusStyle = new Dictionary<string, (string bg, string color)>
    {
        { "Chờ xác nhận", ("#fff3cd", "#856404") },
        { "Đã xác nhận",  ("#cce5ff", "#004085") },
        { "Đang giao",    ("#d1ecf1", "#0c5460") },
        { "Hoàn thành",   ("#d4edda", "#155724") },
        { "Hủy",          ("#f8d7da", "#721c24") },
    };
}

<div class="bg-light py-3">
    <div class="container">
        <div class="col-md-12 mb-0">
            <a href="/">Trang chủ</a> <span class="mx-2">/</span>
            <strong class="text-black">Đơn hàng của tôi</strong>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">
        <div class="row">
            <!-- Sidebar tài khoản -->
            <div class="col-md-3">
                <div class="border p-3 mb-3">
                    <h4 class="mb-3">Tài khoản</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/TaiKhoan/ThongTin" class="text-black">Thông tin cá nhân</a></li>
                        <li class="mb-2"><a href="/TaiKhoan/DonHang" class="text-black fw-bold">Đơn hàng của tôi</a></li>
                        <li class="mb-2"><a href="/TaiKhoan/DoiMatKhau" class="text-black">Đổi mật khẩu</a></li>
                        <li class="mb-2"><hr></li>
                        <li class="mb-2"><a href="/TaiKhoan/DangXuat" class="text-danger">Đăng xuất</a></li>
                    </ul>
                </div>
            </div>

            <!-- Danh sách đơn hàng -->
            <div class="col-md-9">
                <div class="border p-4">
                    <h3 class="mb-4">Đơn hàng của tôi</h3>

                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class='bx bx-package' style="font-size:50px;color:#ccc;"></i>
                            <p class="mt-3 text-muted">Bạn chưa có đơn hàng nào</p>
                            <a href="/SanPham" class="btn btn-black mt-2">Mua sắm ngay</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Ngày đặt</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.OrderByDescending(o => o.thoi_gian_dat))
                                    {
                                        var trangThai = order.trang_thai ?? "";
                                        var st = statusStyle.GetValueOrDefault(trangThai, ("#e2e3e5", "#383d41"));
                                        <tr>
                                            <td><strong>@order.ma_hoa_don</strong></td>
                                            <td>@order.thoi_gian_dat.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td style="color:#c0392b;font-weight:600;">@string.Format("{0:N0}₫", order.tong_tien)</td>
                                            <td>
                                                <span style="display:inline-block;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:600;background:@st.Item1;color:@st.Item2;white-space:nowrap;">
                                                    @trangThai
                                                </span>
                                            </td>
                                            <td style="text-align:right;">
                                                <a href="/TaiKhoan/ChiTietDonHang/@order.id_hoa_don"
                                                   style="display:inline-block;padding:5px 16px;border:1.5px solid #333;border-radius:4px;color:#333;font-size:13px;text-decoration:none;white-space:nowrap;"
                                                   onmouseover="this.style.background='#333';this.style.color='#fff'"
                                                   onmouseout="this.style.background='transparent';this.style.color='#333'">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
