@model knjewelry.Models.Entities.HoaDon
@{
    ViewData["Title"] = "Chi tiết đơn hàng - K&N JEWELRY";
    var statusBadge = new Dictionary<string, string>
    {
        { "Chờ xác nhận", "badge-warning" },
        { "Đã xác nhận",  "badge-primary" },
        { "Đang giao",    "badge-info"    },
        { "Hoàn thành",   "badge-success" },
        { "Hủy",          "badge-danger"  },
    };
    var badgeCls = statusBadge.GetValueOrDefault(Model.trang_thai ?? "", "badge-secondary");
}

<div class="bg-light py-3">
    <div class="container">
        <div class="col-md-12 mb-0">
            <a href="/">Trang chủ</a> <span class="mx-2">/</span>
            <a href="/TaiKhoan/DonHang">Đơn hàng của tôi</a> <span class="mx-2">/</span>
            <strong class="text-black">@Model.ma_hoa_don</strong>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">
        <div class="row">
            <!-- Sidebar tài khoản -->
            <div class="col-md-3">
                <div class="border p-3 mb-3">
                    <h4 class="mb-3">Tài khoản</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/TaiKhoan/ThongTin" class="text-black">Thông tin cá nhân</a></li>
                        <li class="mb-2"><a href="/TaiKhoan/DonHang" class="text-black fw-bold">Đơn hàng của tôi</a></li>
                        <li class="mb-2"><a href="/TaiKhoan/DoiMatKhau" class="text-black">Đổi mật khẩu</a></li>
                        <li class="mb-2"><hr></li>
                        <li class="mb-2"><a href="/TaiKhoan/DangXuat" class="text-danger">Đăng xuất</a></li>
                    </ul>
                </div>
            </div>

            <!-- Chi tiết đơn hàng -->
            <div class="col-md-9">
                <div class="border p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0">@Model.ma_hoa_don</h3>
                        <span class="badge @badgeCls px-3 py-2" style="font-size:14px;">@Model.trang_thai</span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">THÔNG TIN GIAO HÀNG</h6>
                            <p class="mb-1"><strong>@Model.ho_ten</strong></p>
                            <p class="mb-1">@Model.so_dien_thoai</p>
                            <p class="mb-1">@Model.email</p>
                            <p class="mb-1">
                                @Model.dia_chi_cu_the,
                                @Model.phuong_xa,
                                @Model.tinh_thanh_pho
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">THÔNG TIN ĐƠN HÀNG</h6>
                            <p class="mb-1"><strong>Ngày đặt:</strong> @Model.thoi_gian_dat.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Thanh toán:</strong> @Model.phuong_thuc_tt</p>
                            @if (!string.IsNullOrEmpty(Model.ghi_chu))
                            {
                                <p class="mb-1"><strong>Ghi chú:</strong> @Model.ghi_chu</p>
                            }
                        </div>
                    </div>

                    <!-- Sản phẩm -->
                    <h6 class="text-muted mb-2">SẢN PHẨM</h6>
                    <table class="table table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ChiTietHoaDons != null)
                            {
                                @foreach (var ct in Model.ChiTietHoaDons)
                                {
                                    <tr>
                                        <td>
                                            <strong>@ct.ten_sp_luu</strong>
                                            @if (!string.IsNullOrEmpty(ct.kich_co_luu) || !string.IsNullOrEmpty(ct.mau_sac_luu))
                                            {
                                                <small class="text-muted d-block">
                                                    @string.Join(" / ", new[] { ct.kich_co_luu, ct.mau_sac_luu }.Where(x => !string.IsNullOrEmpty(x)))
                                                </small>
                                            }
                                        </td>
                                        <td class="text-center">@ct.so_luong</td>
                                        <td class="text-end">@string.Format("{0:N0}₫", ct.don_gia)</td>
                                        <td class="text-end">@string.Format("{0:N0}₫", ct.so_luong * ct.don_gia)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tạm tính</th>
                                <th class="text-end">@string.Format("{0:N0}₫", Model.tien_hang)</th>
                            </tr>
                            @if (Model.tien_giam > 0)
                            {
                                <tr>
                                    <th colspan="3" class="text-end text-success">Giảm giá</th>
                                    <th class="text-end text-success">-@string.Format("{0:N0}₫", Model.tien_giam)</th>
                                </tr>
                            }
                            <tr>
                                <th colspan="3" class="text-end">Phí vận chuyển</th>
                                <th class="text-end">@string.Format("{0:N0}₫", Model.phi_van_chuyen)</th>
                            </tr>
                            <tr class="table-active">
                                <th colspan="3" class="text-end">Tổng cộng</th>
                                <th class="text-end text-danger" style="font-size:1.1rem;">@string.Format("{0:N0}₫", Model.tong_tien)</th>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="mt-3">
                        <a href="/TaiKhoan/DonHang" class="btn btn-outline-dark">
                            <i class='bx bx-left-arrow-alt'></i> Quay lại
                        </a>
                        <a href="/SanPham" class="btn btn-black ms-2">
                            <i class='bx bx-store'></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
