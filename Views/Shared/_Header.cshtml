@{
    var userId    = Context.Session.GetInt32("UserId");
    var userName  = Context.Session.GetString("UserName") ?? "";
    var userRole  = Context.Session.GetString("UserRole") ?? "";
    var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
    var daDangNhap = userId.HasValue && userId.Value > 0;
    var tenHienThi = userName.Length > 14 ? userName.Substring(0, 14) + "…" : userName;
}

<style>
    /* Account menu — dùng CSS thuần, không phụ thuộc Bootstrap dropdown */
    .account-wrap {
        position: relative;
        display: inline-block;
    }
    .account-trigger {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #333;
        color: #fff !important;
        padding: 5px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none !important;
    }
    .account-trigger:hover {
        background: #483925;
        color: #fff !important;
    }
    .account-menu {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        background: #fff;
        min-width: 210px;
        border-radius: 8px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        border: 1px solid #eee;
        z-index: 2000;
    }
    .account-wrap:hover .account-menu {
        display: block;
    }
    .account-menu-header {
        padding: 10px 15px;
        border-bottom: 1px solid #eee;
    }
    .account-menu a {
        display: block;
        padding: 10px 15px;
        font-size: 14px;
        color: #333 !important;
        text-decoration: none !important;
        transition: background 0.2s;
    }
    .account-menu a:hover {
        background: #f8f5f0;
        color: #483925 !important;
    }
    .account-menu hr {
        margin: 4px 0;
        border-color: #eee;
    }
</style>

<div class="site-navbar bg-white py-2">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">

            <!-- Logo -->
            <div class="site-logo" style="flex-shrink:0;">
                <a href="/" class="js-logo-clone">K&N JEWELRY</a>
            </div>

            <!-- Menu chính -->
            <div class="main-nav d-none d-lg-block">
                <nav class="site-navigation" role="navigation">
                    <ul class="site-menu">
                        <li><a href="/">Trang chủ</a></li>
                        @await Component.InvokeAsync("Menu")
                        <li><a href="/LienHe">Liên hệ</a></li>
                        <li><a href="/TraCuu">Tra cứu</a></li>
                    </ul>
                </nav>
            </div>

            <!-- Icons bên phải -->
            <div class="d-flex align-items-center" style="gap:10px;flex-shrink:0;">

                <!-- TÀI KHOẢN — CSS thuần :hover, không dùng Bootstrap dropdown -->
                @if (daDangNhap)
                {
                    <div class="account-wrap">
                        <span class="account-trigger">
                            <i class='bx bx-user-circle' style="font-size:16px;"></i>
                            @tenHienThi
                            <i class='bx bx-chevron-down' style="font-size:13px;"></i>
                        </span>
                        <div class="account-menu">
                            <div class="account-menu-header">
                                <small style="color:#999;">Xin chào,</small>
                                <div style="font-weight:600;color:#333;">@userName</div>
                            </div>
                            <a href="/TaiKhoan/ThongTin">
                                <i class='bx bx-user mr-2'></i>Thông tin tài khoản
                            </a>
                            <a href="/TaiKhoan/DonHang">
                                <i class='bx bx-package mr-2'></i>Đơn hàng của tôi
                            </a>
                            @if (userRole == "quan_tri")
                            {
                                <hr>
                                <a href="/admin/" style="color:#007bff!important;">
                                    <i class='bx bx-shield mr-2'></i>Quản trị
                                </a>
                            }
                            <hr>
                            <a href="/TaiKhoan/DangXuat" style="color:#dc3545!important;">
                                <i class='bx bx-log-out mr-2'></i>Đăng xuất
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/TaiKhoan/DangNhap" class="account-trigger">
                        <i class='bx bx-user-circle' style="font-size:16px;"></i>
                        Đăng nhập
                    </a>
                }

                <!-- GIỎ HÀNG -->
                <a href="/GioHang" style="position:relative;font-size:22px;color:#333!important;line-height:1;">
                    <i class='bx bx-shopping-bag'></i>
                    <span id="cart-count"
                          style="position:absolute;top:-5px;right:-8px;
                                 background:#c0392b;color:#fff;border-radius:50%;
                                 min-width:16px;height:16px;font-size:10px;font-weight:bold;
                                 display:flex;align-items:center;justify-content:center;padding:0 2px;">
                        @cartCount
                    </span>
                </a>

                <!-- TÌM KIẾM -->
                <form action="/SanPham/Index" method="get" class="d-none d-xl-block" style="margin:0;">
                    <div class="input-group input-group-sm" style="width:155px;">
                        <input type="text" name="search" class="form-control"
                               placeholder="Tìm kiếm..."
                               value="@Context.Request.Query["search"]">
                        <div class="input-group-append">
                            <button class="btn btn-dark" type="submit">
                                <i class='bx bx-search'></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
