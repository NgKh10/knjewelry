@model IEnumerable<knjewelry.Models.Entities.LoaiSanPham>

@{
    var currentLoaiId = ViewContext.HttpContext.Request.Query["loaiId"].ToString();
    var currentLoaiIdInt = string.IsNullOrEmpty(currentLoaiId) ? 0 : int.Parse(currentLoaiId);
}

@foreach (var category in Model)
{
    var isActive = (currentLoaiIdInt == category.id_loai_sp);

    if (category.LoaiCon != null && category.LoaiCon.Any())
    {
        <li class="mb-2">
            <a href="/SanPham?loaiId=@category.id_loai_sp"
               class="@(isActive ? "fw-bold text-dark" : "")">
                @category.ten_loai
            </a>
            <ul class="sub-menu" style="padding-left: 20px; margin-top: 5px;">
                @foreach (var child in category.LoaiCon)
                {
                    var isChildActive = (currentLoaiIdInt == child.id_loai_sp);
                    <li class="mb-1">
                        <a href="/SanPham?loaiId=@child.id_loai_sp"
                           class="@(isChildActive ? "fw-bold text-dark" : "")">
                            - @child.ten_loai
                        </a>
                    </li>
                }
            </ul>
        </li>
    }
    else
    {
        <li class="mb-2">
            <a href="/SanPham?loaiId=@category.id_loai_sp"
               class="@(isActive ? "fw-bold text-dark" : "")">
                @category.ten_loai
            </a>
        </li>
    }
}