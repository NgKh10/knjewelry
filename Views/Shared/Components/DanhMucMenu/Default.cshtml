@model IEnumerable<knjewelry.Models.Entities.LoaiSanPham>

@{
    var currentLoaiId = ViewContext.HttpContext.Request.Query["loaiId"].ToString();
    var currentLoaiIdInt = string.IsNullOrEmpty(currentLoaiId) ? 0 : int.Parse(currentLoaiId);
}

@if (Model != null && Model.Any())
{
    foreach (var category in Model)
    {
        var isActive = (currentLoaiIdInt == category.id_loai_sp);
        
        <li class="mb-2">
            <a href="/SanPham?loaiId=@category.id_loai_sp"
               class="@(isActive ? "fw-bold text-dark" : "")">
                @category.ten_loai
            </a>
        </li>
    }
}
else
{
    <li class="mb-2">
        <span class="text-muted">Đang cập nhật...</span>
    </li>
}