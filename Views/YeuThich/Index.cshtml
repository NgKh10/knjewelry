@model IEnumerable<knjewelry.Models.Entities.SanPham>
@{
    ViewData["Title"] = "Danh sách yêu thích - K&N JEWELRY";
    var wishlistIds = ViewBag.WishlistIds as List<int> ?? new List<int>();
}

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0">
                <a href="/">Trang chủ</a> <span class="mx-2 mb-0">/</span>
                <strong class="text-black">Danh sách yêu thích</strong>
            </div>
        </div>
    </div>
</div>

<div class="site-section">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row" id="wishlist-container">
                @foreach (var product in Model)
                {
                    <div class="col-lg-3 col-md-6 item-entry mb-4" data-product-id="@product.id_san_pham">
                        <a href="/SanPham/Detail/@product.id_san_pham" class="product-item d-block">
                            <img src="@(product.HinhAnhs?.FirstOrDefault()?.duong_dan ?? "/images/default.jpg")" alt="@product.ten_sp" class="img-fluid">
                        </a>
                        <h3 class="item-title mt-2">
                            <a href="/SanPham/Detail/@product.id_san_pham">@product.ten_sp</a>
                        </h3>
                        <div class="item-price">
                            <span class="current-price">@string.Format("{0:N0}₫", product.gia_khuyen_mai ?? product.gia)</span>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-sm btn-dark w-50 btn-add-cart" data-id="@product.id_san_pham">
                                <i class='bx bx-cart-add'></i> Mua
                            </button>
                            <button class="btn btn-sm btn-danger w-50 btn-remove-wishlist" data-id="@product.id_san_pham">
                                <i class='bx bx-heart'></i> Xóa
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <button id="btn-clear-all" class="btn btn-outline-danger">
                    <i class='bx bx-trash'></i> Xóa tất cả
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class='bx bx-heart' style="font-size: 60px; color: #ccc;"></i>
                <h3 class="mt-3">Danh sách yêu thích trống</h3>
                <p>Hãy thêm sản phẩm bạn yêu thích!</p>
                <a href="/SanPham" class="btn btn-black mt-3">Mua sắm ngay</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Sử dụng vanilla JavaScript, không cần jQuery
        document.addEventListener('DOMContentLoaded', function () {

            // Thêm vào giỏ hàng
            document.querySelectorAll('.btn-add-cart').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var id = this.dataset.id;

                    fetch('/GioHang/ThemVaoGio', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: 'sanPhamId=' + id + '&soLuong=1'
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                var cartBadge = document.getElementById('cart-count');
                                if (cartBadge) cartBadge.textContent = data.soLuongGioHang;
                                alert('Đã thêm vào giỏ hàng!');
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            });

            // Xóa khỏi wishlist - dùng SweetAlert
            document.querySelectorAll('.btn-remove-wishlist').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var id = this.dataset.id;
                    var item = this.closest('.item-entry');
                    var productName = item?.querySelector('.item-title a')?.textContent || 'sản phẩm này';

                    Swal.fire({
                        title: 'Xóa khỏi yêu thích?',
                        text: `Bạn có chắc muốn xóa "${productName}" khỏi danh sách yêu thích?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#483925',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Xóa',
                        cancelButtonText: 'Hủy'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Gọi API xóa
                            fetch('/YeuThich/Xoa', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                },
                                body: 'id=' + id
                            })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        // Cập nhật localStorage
                                        var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
                                        wishlist = wishlist.filter(function (item) { return item != id; });
                                        localStorage.setItem('wishlist', JSON.stringify(wishlist));

                                        // Xóa dòng sản phẩm với hiệu ứng đẹp
                                        if (item) {
                                            item.style.transition = 'all 0.3s ease';
                                            item.style.transform = 'scale(0.9)';
                                            item.style.opacity = '0';
                                            setTimeout(function () {
                                                item.remove();
                                                if (document.querySelectorAll('.item-entry').length === 0) {
                                                    location.reload();
                                                }
                                            }, 300);
                                        }

                                        // Thông báo thành công
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Đã xóa!',
                                            text: 'Sản phẩm đã được xóa khỏi danh sách yêu thích.',
                                            timer: 1500,
                                            showConfirmButton: false
                                        });
                                    }
                                })
                                .catch(error => {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Lỗi!',
                                        text: 'Có lỗi xảy ra, vui lòng thử lại.',
                                    });
                                });
                        }
                    });
                });
            });

            // Xóa tất cả - dùng SweetAlert
            var clearBtn = document.getElementById('btn-clear-all');
            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    var count = document.querySelectorAll('.btn-remove-wishlist').length;
                    if (count === 0) return;

                    Swal.fire({
                        title: 'Xóa tất cả?',
                        text: `Bạn có chắc muốn xóa tất cả ${count} sản phẩm khỏi danh sách yêu thích?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Xóa tất cả',
                        cancelButtonText: 'Hủy'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            var ids = [];
                            document.querySelectorAll('.btn-remove-wishlist').forEach(function (btn) {
                                ids.push(btn.dataset.id);
                            });

                            var promises = ids.map(function (id) {
                                return fetch('/YeuThich/Xoa', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded',
                                    },
                                    body: 'id=' + id
                                });
                            });

                            Promise.all(promises)
                                .then(function () {
                                    localStorage.setItem('wishlist', JSON.stringify([]));
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Đã xóa tất cả!',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                    setTimeout(function () {
                                        location.reload();
                                    }, 1500);
                                })
                                .catch(function () {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Lỗi!',
                                        text: 'Có lỗi xảy ra, vui lòng thử lại.',
                                    });
                                });
                        }
                    });
                });
            }
        });
    </script>
}